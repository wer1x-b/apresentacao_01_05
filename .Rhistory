total_obitos = Ano
) %>%
# Tratamento dos dados de texto para numérico
mutate(
# Remove asteriscos dos anos (ex: "2025*") e converte para número
ano = as.numeric(str_remove(ano, "\\*")),
# Remove os pontos de milhar e converte o total para número
total_obitos = as.numeric(str_remove_all(total_obitos, "\\."))
) %>%
# Filtro opcional: remover agrupamentos totais que podem distorcer a escala
# A base possui grupos como "10 a 49" que englobam os menores.
filter(!grupo_etario %in% c("10 a 49", "Todos"))
# 3. Geração do Gráfico (ggplot2)
# Estrutura baseada na sobreposição de série temporal por faixa etária
grafico_obitos <- ggplot(dados_limpos, aes(x = ano, y = total_obitos, color = grupo_etario)) +
geom_line(linewidth = 1) +
geom_point(size = 2.5) +
# Formatação dos eixos
scale_x_continuous(breaks = unique(dados_limpos$ano)) +
scale_y_continuous(labels = label_number(big.mark = ".", decimal.mark = ",")) +
# Estética e rótulos
theme_minimal() +
labs(
title = "Evolução de Óbitos por Grupo Etário",
subtitle = "Série temporal segmentada por faixa de idade",
x = "Ano",
y = "Número Total de Óbitos",
color = "Grupo Etário"
) +
theme(
legend.position = "bottom",
plot.title = element_text(face = "bold", size = 14),
panel.grid.minor = element_blank()
)
# Exibir o gráfico
print(grafico_obitos)
