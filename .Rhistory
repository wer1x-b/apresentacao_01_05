"28" = "se",
"29" = "ba",
"31" = "mg",
"32" = "es"
)
# Caminho onde os arquivos serão salvos
caminho_pasta <- "/home/wericky/semiarido/saidas"
# Função para salvar os dados por estado
salvar <- function(cod, uf, dados, caminho_pasta) {
dados_por_estado <- peso_semiarido |>
filter(str_starts(as.character(codmunres), cod))
if (nrow(dados_por_estado) > 0) {
caminho <- file.path(caminho_pasta, paste0("peso_", uf, "_2024.xlsx"))
writexl::write_xlsx(dados_por_estado, caminho)
message("Arquivo salvo em: ", caminho)
}
}
# Loop executar a função salvar()
for (cod in names(cod_estados)) {
salvar(cod, cod_estados[[cod]], tabela_dados, caminho_pasta)
}
