library(microdatasus)
library(dplyr)
library(tidyr)
library(readr)
library(stringr)
library(readxl)
library(janitor)
library(writexl)
# Importando dados do SINASC
dados <- fetch_datasus(
year_start = 2024,
year_end = 2024,
uf = c("MA", "PI", "CE", "PB", "ES", "MG", "BA", "SE", "RN", "AL", "PE"),
information_system = "SINASC"
)
# Convertendo para número
dados <- dados |>
mutate(IDADEMAE = as.numeric(IDADEMAE))
# Criando categorias
dados_agrupados <- dados |>
filter(IDADEMAE >= 10 & IDADEMAE <= 49) |>
mutate(faixa = case_when(
IDADEMAE >= 10 & IDADEMAE <= 14 ~ "10 – 14",
IDADEMAE >= 15 & IDADEMAE <= 19 ~ "15 – 19",
IDADEMAE >= 20 & IDADEMAE <= 24 ~ "20 – 24",
IDADEMAE >= 25 & IDADEMAE <= 29 ~ "25 – 29",
IDADEMAE >= 30 & IDADEMAE <= 34 ~ "30 – 34",
IDADEMAE >= 35 & IDADEMAE <= 39 ~ "35 – 39",
IDADEMAE >= 40 & IDADEMAE <= 44 ~ "40 – 44",
IDADEMAE >= 45 & IDADEMAE <= 49 ~ "45 – 49"
)) |>
group_by(CODMUNRES, faixa) |>
summarise(n = n(), .groups = "drop") |>
pivot_wider(names_from = faixa, values_from = n, values_fill = 0)
# Criando coluna de TOTAL
dados_agrupados <- dados_agrupados |>
mutate(TOTAL = rowSums(across(where(is.numeric))))
# Carregando dados do semiarido e tipologia
semiarido <- read.csv2("/home/wericky/semiarido/semiarido.csv")
# Ajustado os códigos dos municípios
dados_agrupados <- dados_agrupados |>
mutate(CODMUNRES = as.numeric(str_sub(as.character(CODMUNRES), 1, 6)))
semiarido1 <- semiarido |>
mutate(CD_MUN = as.numeric(str_sub(as.character(CD_MUN), 1, 6)))
# Filtrando apenas municípios do semiárido
dados_agrupados <- dados_agrupados |>
inner_join(semiarido1, by = c("CODMUNRES" = "CD_MUN"))
# Atribuindo aos municípios suas respectivas tipologias
tabela_dados <- dados_agrupados |>
select(!CD_MUN1) |>
relocate(CODMUNRES, NM_MUN)
tabela_dados <- tabela_dados %>%
relocate(`10 – 14`, .after = NM_MUN) %>%
relocate(`25 – 29`, .after = `20 – 24`)
write_xlsx(tabela_dados, "tabela_dados_final.xlsx")
