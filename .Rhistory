############ Questão 1 - Modelos de Regressão Linear e Quadrática ##################
rm(list=ls())
############ Questão 1 - Modelos de Regressão Linear e Quadrática ##################
rm(list=ls())
# Entrada dos dados
x <- c(1, 2, 3, 4, 5, 6)
y <- c(5, 7, 7, 10, 16, 20)
# Ajuste do Modelo 1: y = a + bX
mod_linear <- lm(y ~ x)
print("Resumo do Modelo Linear:")
summary(mod_linear)
# Ajuste do Modelo 2: y = a + bX + cX²
mod_quad <- lm(y ~ x + I(x^2))
print("Resumo do Modelo Quadrático:")
summary(mod_quad)
# ---------------------------------------------------------
# Gráfico de Dispersão e Ajustes
# ---------------------------------------------------------
plot(x, y,
main = "Ajuste Linear vs Quadrático",
xlab = "Variável X",
ylab = "Variável Y",
pch = 19)
# Adicionando a reta do modelo linear (vermelho)
abline(mod_linear, col = "red", lwd = 2)
# Adicionando a curva do modelo quadrático (azul)
# Como não é uma reta, precisamos prever pontos ao longo do eixo x para desenhar a curva
linhas_x <- seq(min(x), max(x), length.out = 100)
linhas_y <- predict(mod_quad, data.frame(x = linhas_x))
lines(linhas_x, linhas_y, col = "blue", lwd = 2)
legend("topleft", legend = c("Linear", "Quadrático"),
col = c("red", "blue"), lty = 1, lwd = 2)
# Comparação formal com Teste F (ANOVA)
print("Tabela ANOVA comparando os modelos:")
anova(mod_linear, mod_quad)
