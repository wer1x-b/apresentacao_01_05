        "#| warning: false\n",
        "import pandas as pd\n",
        "import plotly.express as px\n",
        "import json\n",
        "import urllib.request\n",
        "\n",
        "# 1. Carregar a malha geográfica do Brasil\n",
        "url_geojson = \"https://raw.githubusercontent.com/codeforamerica/click_that_hood/master/public/data/brazil-states.geojson\"\n",
        "with urllib.request.urlopen(url_geojson) as response:\n",
        "    brasil_estados = json.load(response)\n",
        "\n",
        "# 2. Leitura dos Óbitos Maternos (SIM)\n",
        "df_obitos = pd.read_csv(\"mortalidade_estados.csv.csv\", sep=\";\", decimal=\",\", thousands=\".\", encoding=\"utf-8\")\n",
        "df_obitos_estados = df_obitos[\n",
        "    (df_obitos['abrangencia (nome)'] == 'Unidade da federação') & \n",
        "    (df_obitos['grupoetario (nome)'] == '10 a 49')\n",
        "].copy()\n",
        "\n",
        "# Padronizando a coluna para o cruzamento\n",
        "df_obitos_estados['estado_limpo'] = df_obitos_estados['localidade (nome)'].str.strip()\n",
        "df_obitos_estados['total_obitos'] = df_obitos_estados['Ano']\n",
        "\n",
        "# 3. Leitura dos Nascidos Vivos (SINASC)\n",
        "# Pula as 3 primeiras linhas de cabeçalho sujo do TabNet\n",
        "df_nasc = pd.read_csv('nascidos_vivos_estados.csv.csv', sep=';', skiprows=3, encoding='latin-1')\n",
        "df_nasc = df_nasc.dropna(subset=['Nascim_p/resid.mãe']).copy()\n",
        "\n",
        "# Remove os pontos e espaços que o TabNet coloca antes do nome (ex: \".. Rondônia\")\n",
        "df_nasc['estado_limpo'] = df_nasc['Região/Unidade da Federação'].str.replace(r'^\\.\\.\\s*', '', regex=True).str.strip()\n",
        "df_nasc['total_nascimentos'] = df_nasc['Nascim_p/resid.mãe']\n",
        "\n",
        "# 4. Cruzamento dos Dados (Merge)\n",
        "df_final = pd.merge(df_obitos_estados, df_nasc, on='estado_limpo')\n",
        "\n",
        "mapa_siglas_nome = {\n",
        "    'Acre': 'AC', 'Alagoas': 'AL', 'Amapá': 'AP', 'Amazonas': 'AM', 'Bahia': 'BA', \n",
        "    'Ceará': 'CE', 'Distrito Federal': 'DF', 'Espírito Santo': 'ES', 'Goiás': 'GO', \n",
        "    'Maranhão': 'MA', 'Mato Grosso': 'MT', 'Mato Grosso do Sul': 'MS', 'Minas Gerais': 'MG', \n",
        "    'Pará': 'PA', 'Paraíba': 'PB', 'Paraná': 'PR', 'Pernambuco': 'PE', 'Piauí': 'PI', \n",
        "    'Rio de Janeiro': 'RJ', 'Rio Grande do Norte': 'RN', 'Rio Grande do Sul': 'RS', \n",
        "    'Rondônia': 'RO', 'Roraima': 'RR', 'Santa Catarina': 'SC', 'São Paulo': 'SP', \n",
        "    'Sergipe': 'SE', 'Tocantins': 'TO'\n",
        "}\n",
        "df_final['sigla'] = df_final['estado_limpo'].map(mapa_siglas_nome)\n",
        "\n",
        "# 5. O CÁLCULO DA RMM (A Mágica acontece aqui)\n",
        "df_final['RMM'] = (df_final['total_obitos'] / df_final['total_nascimentos']) * 100000\n",
        "df_final['RMM'] = df_final['RMM'].round(1)\n",
        "\n",
        "# 6. Construção do Mapa Coroplético Interativo\n",
        "fig_mapa = px.choropleth(\n",
