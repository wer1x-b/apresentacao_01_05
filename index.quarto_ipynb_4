        "#| warning: false\n",
        "import plotly.express as px\n",
        "import plotly.graph_objects as go\n",
        "\n",
        "# 1. Preparação dos Dados\n",
        "# Utilizamos o df_final que já contém a RMM calculada na Parte 3\n",
        "# Ordenamos do menor (melhor cenário) para o maior (pior cenário)\n",
        "df_ods = df_final.sort_values('RMM').copy()\n",
        "\n",
        "# Calculamos a média nacional para servir de parâmetro extra\n",
        "obitos_totais_br = df_ods['total_obitos'].sum()\n",
        "nascimentos_totais_br = df_ods['total_nascimentos'].sum()\n",
        "rmm_brasil = (obitos_totais_br / nascimentos_totais_br) * 100000\n",
        "\n",
        "# Criamos uma coluna de cor condicional: \n",
        "# Verde para quem atingiu a meta (<= 70), Roxo para quem está acima (> 70)\n",
        "df_ods['Status_ODS'] = df_ods['RMM'].apply(lambda x: 'Atingiu a Meta' if x <= 70 else 'Acima da Meta')\n",
        "paleta_cores = {'Atingiu a Meta': '#2ecc71', 'Acima da Meta': '#9b59b6'}\n",
        "\n",
        "# 2. Construção do Gráfico de Barras\n",
        "fig_ods = px.bar(\n",
        "    df_ods, \n",
        "    x='sigla', \n",
        "    y='RMM', \n",
        "    color='Status_ODS',\n",
        "    color_discrete_map=paleta_cores,\n",
        "    title='<b>Distância para o ODS 3.1: Mortalidade Materna por Estado</b><br><sup>Comparativo com a meta global da ONU de 70 óbitos/100 mil NV</sup>',\n",
