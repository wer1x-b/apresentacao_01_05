        "    annotation_position=\"bottom right\",\n",
        "    annotation_font=dict(color=\"#34495e\", size=11)\n",
        ")\n",
        "\n",
        "# 4. Refinamento de Layout\n",
        "fig_ods.update_layout(\n",
