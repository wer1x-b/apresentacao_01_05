        "    line_dash=\"dash\", \n",
        "    line_color=\"#e74c3c\", \n",
        "    line_width=3,\n",
        "    annotation_text=\"Meta ONU (70)\", \n",
        "    annotation_position=\"top left\",\n",
        "    annotation_font=dict(color=\"#e74c3c\", size=12, weight=\"bold\")\n",
